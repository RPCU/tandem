# tandem-relay on a home server or a small VPS (docs/relay.md).
#
#   install -m 0755 tandem-relay /usr/local/bin/tandem-relay
#   install -m 0644 tandem-relay.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now tandem-relay
#
# Open to anyone, with the open mode's limits (docs/relay.md). Host tokens
# (optional: their holders bypass the limits; required with
# --require-token) come with a drop-in, `systemctl edit tandem-relay`:
#
#   [Service]
#   ExecStart=
#   ExecStart=/usr/local/bin/tandem-relay serve --udp=:27460 \
#     --http=127.0.0.1:8080 --host-tokens=%d/host-tokens
#   LoadCredential=host-tokens:/etc/tandem-relay/host-tokens
#
# after `install -d -m 0700 /etc/tandem-relay; tandem-relay token >
# /etc/tandem-relay/host-tokens; chmod 0600 /etc/tandem-relay/host-tokens`.
# The token file is read once, at start: restart the relay after changing
# it (running sessions are held and come back by themselves).
[Unit]
Description=tandem-relay: UDP relay for tandem co-op sessions
Documentation=https://github.com/Banh-Canh/tandem
After=network-online.target
Wants=network-online.target

[Service]
# Players on UDP 27460, from anywhere. Health and metrics on loopback only:
# nothing but this machine (a local Prometheus, curl) reads them.
ExecStart=/usr/local/bin/tandem-relay serve \
  --udp=:27460 \
  --http=127.0.0.1:8080 \
  --host-tokens=
Restart=on-failure
RestartSec=2

# No user to create, nothing to write, nothing to gain: the relay needs a
# UDP socket, a TCP socket and (with the drop-in) its token file, the
# service's own read-only copy of root's.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# The same ceiling as the Kubernetes base.
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
