# tandem-relay on a home server or a small VPS (docs/relay.md).
#
#   install -m 0755 tandem-relay /usr/local/bin/tandem-relay
#   install -d -m 0700 /etc/tandem-relay
#   tandem-relay token > /etc/tandem-relay/host-tokens   # one line per host
#   chmod 0600 /etc/tandem-relay/host-tokens
#   install -m 0644 tandem-relay.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now tandem-relay
#
# The token file is read once, at start: `systemctl restart tandem-relay`
# after changing it (running sessions end; games reconnect by themselves).
[Unit]
Description=tandem-relay: UDP relay for tandem co-op sessions
Documentation=https://github.com/Banh-Canh/tandem
After=network-online.target
Wants=network-online.target

[Service]
# Players on UDP 27460, from anywhere. Health and metrics on loopback only:
# nothing but this machine (a local Prometheus, curl) reads them.
ExecStart=/usr/local/bin/tandem-relay serve \
  --udp=:27460 \
  --http=127.0.0.1:8080 \
  --host-tokens=%d/host-tokens
# The tokens stay root's: the service gets its own read-only copy.
LoadCredential=host-tokens:/etc/tandem-relay/host-tokens
Restart=on-failure
RestartSec=2

# No user to create, nothing to write, nothing to gain: the relay needs a
# UDP socket, a TCP socket and its token file.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# The same ceiling as the Kubernetes base.
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
