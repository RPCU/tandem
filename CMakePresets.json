{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Game plugin (Windows x64, clang-cl from Linux)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "toolchainFile": "${sourceDir}/cmake/clang-cl-msvc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TANDEM_BUILD_PLUGIN": "ON",
        "TANDEM_BUILD_PEER": "OFF"
      }
    },
    {
      "name": "linux",
      "displayName": "Mock player and tests (Linux)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TANDEM_BUILD_PLUGIN": "OFF",
        "TANDEM_BUILD_PEER": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows" },
    { "name": "linux", "configurePreset": "linux" }
  ],
  "testPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true }
    }
  ]
}
