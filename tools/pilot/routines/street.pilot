# A street walk, for the "street" recording: a walk, a jog, a sprint, a
# stretch crouched, and back to the start. Distances are from where V
# stands (pilot-street's PILOT_AT, the niwaki-plaza fixture by default:
# testing.md "Fixtures"): run survey.pilot first on a new spot and move the
# waypoints where the ground is open.
limit 240
needs veh == 0
calibrate move
walk ~0 ~8 pace walk
walk ~8 ~8
walk ~8 ~0 pace walk
walk ~0 ~0
walk ~0 ~14 pace sprint
walk ~0 ~0 pace sprint
# Crouched for a few metres.
press b
optional until crouch == 1 timeout 1.5
# A tap the game did not take as ToggleCrouch's: its hold toggles crouch
# too (IsActionJustHeld, final.reds:282129).
if crouch == 0
  press b 0.5
end
until crouch == 1 timeout 3
walk ~4 ~4 pace walk
press b
optional until crouch == 0 timeout 1.5
# A tap the game did not take as ToggleCrouch's: its hold toggles crouch
# too (IsActionJustHeld, final.reds:282129).
if crouch == 1
  press b 0.5
end
until crouch == 0 timeout 3
walk ~0 ~0
