# A drive through a few blocks, for the "drive" recording: V calls its car,
# gets in at the wheel, drives (the game's AutoDrive when it takes over,
# the pad otherwise), stops, gets out and walks away.
limit 420
needs veh == 0
sim car 3 6
if car < 0
  act summon
end
until car > 0 and car < 20 timeout 40
act mount
until veh == 1 and seat == driver timeout 12
wait 2
optional act autodrive on
wait 1
if auto == 1
  say AutoDrive drives
  wait 25
  act autodrive off
  until auto == 0 timeout 5
else
  say the pad drives
  calibrate steer
  drive ~0 ~60 speed 10
  drive ~40 ~90 speed 10
  drive ~40 ~150 speed 12
end
trigger lt 1 3
until speed < 0.5 timeout 10
act exit
until veh == 0 timeout 10
wait 1
stick left 0 1 4
